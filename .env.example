# Copy this to .env and fill in values
# Docker Compose reads .env automatically — required when using docker-compose up
DOCKER_DB_PASSWORD=changeme
JWT_SECRET=replace-with-base64-256bit-secret
ALLOWED_ORIGINS=http://localhost:3000

# Frontend — React (set at build time or in Cloudflare Pages env)
REACT_APP_API_URL=http://localhost:8080

# Backend — set these in Render (or locally when running with prod profile)
# DATABASE_URL=jdbc:postgresql://ep-xxx.neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=your-neon-user
# DATABASE_PASSWORD=your-neon-password
# JWT_EXPIRATION_MS=86400000
# SPRING_PROFILES_ACTIVE=prod
