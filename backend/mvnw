#!/bin/sh
# Maven Wrapper startup script, version 3.3.2

# Resolve the project base dir FIRST — the wrapper jar/properties paths are
# derived from it. (The previous version referenced it before it was set, so it
# always looked for /.mvn/wrapper/maven-wrapper.jar and failed on Linux/CI.)
if [ -z "$MAVEN_PROJECTBASEDIR" ]; then
    MAVEN_PROJECTBASEDIR="$(cd "$(dirname "$0")" && pwd)"
fi
export MAVEN_PROJECTBASEDIR

MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"

if [ ! -f "$MAVEN_WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    curl -fsSL -o "$MAVEN_WRAPPER_JAR" \
        "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
fi

# The wrapper jar ships without a Main-Class manifest, so launch it via the
# classpath and its main class (as the stock mvnw does), not `java -jar`.
exec java -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" \
    -classpath "$MAVEN_WRAPPER_JAR" \
    org.apache.maven.wrapper.MavenWrapperMain "$@"
